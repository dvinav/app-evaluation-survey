{
  "name": "app-evaluation-survey",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open-source questionnaire platform for evaluating and ranking software applications based on UI/UX ratings. Built with Next.js and Payload CMS.",
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack && node scripts/prepare-standalone.mjs",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "seed": "tsx scripts/seed.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "admin:reset-password": "tsx scripts/reset-admin-password.ts"
  },
  "dependencies": {
    "payload": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/translations": "3.92.1",
    "@payloadcms/plugin-import-export": "3.92.1",
    "next": "16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "graphql": "^16.11.0",
    "sharp": "^0.34.5",
    "next-intl": "^4.8.3",
    "next-themes": "^0.4.6",
    "zod": "^4.3.6",
    "react-hook-form": "^7.71.2",
    "@hookform/resolvers": "^6.0.2",
    "@fontsource-variable/vazirmatn": "^5.2.8",
    "pg": "^8.18.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/pg": "^8.16.0",
    "tailwindcss": "^4.2.1",
    "@tailwindcss/postcss": "^4.2.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "vitest": "^4.0.18",
    "@playwright/test": "^1.58.2",
    "tsx": "^4.21.0",
    "dotenv": "^17.3.1",
    "node": "^24.22.1"
  },
  "trustedDependencies": [
    "sharp",
    "@swc/core",
    "@parcel/watcher",
    "unrs-resolver",
    "node"
  ]
}
