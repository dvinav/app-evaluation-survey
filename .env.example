# Copy to .env. Never commit .env or use these sample credentials in production.
# Generate a secret with: openssl rand -hex 32
PAYLOAD_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SERVER_URL=http://localhost:3000
DATABASE_URL=postgres://survey:local-development-password@localhost:5432/survey
POSTGRES_DB=survey
POSTGRES_USER=survey
POSTGRES_PASSWORD=local-development-password
MEDIA_DIR=media
NEXT_TELEMETRY_DISABLED=1
# Optional: name of a SINGLE IP header overwritten by your trusted reverse proxy.
# Leave empty for a shared installation-wide rate limit. Never trust arbitrary X-Forwarded-For.
TRUSTED_IP_HEADER=
# Attempts per 10 minutes: default 30 per trusted IP or 300 installation-wide.
SUBMISSION_RATE_LIMIT=300
# Used only by scripts/admin:create; remove after bootstrapping.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Required only by the production Compose example; set to your published ghcr.io image.
APP_IMAGE=
MIGRATION_IMAGE=
# Optional synthetic admin credentials for authenticated browser tests only.
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# Optional installed Chrome executable when the Chromium download is unavailable.
# PLAYWRIGHT_EXECUTABLE_PATH=
